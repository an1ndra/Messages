<?xml version="1.0" encoding="utf-8"?>
<!--
  Themed-icon layer.

  The user's call: under a themed icon the bubble keeps its *fill* and the three
  message lines are the parts that read as light. A monochrome layer is a mask —
  the launcher tints every opaque pixel one colour and the rest shows the plate
  behind it — so lines cannot be drawn on top of a fill: they have to be holes.

  So the bubble is one filled path and the three lines are capsule subpaths cut
  out of it with fillType="evenOdd". Nothing is stroked here; a stroke would be
  opaque and would merge into the fill, which is how this layer first rendered
  as a blank shape.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:scaleX="1.05"
        android:scaleY="1.05"
        android:translateX="16.2"
        android:translateY="16.2">

        <!-- Bubble, then the three line capsules as holes. Each capsule is the
             2.5dp stroke of the coloured icon expanded to its outer edge
             (r=1.25) and closed with half-circle ends. -->
        <path
            android:fillColor="#FFFFFF"
            android:fillType="evenOdd"
            android:pathData="M36,12C22.745,12 12,21.4 12,33C12,39.3 15.2,44.9 20.2,48.8V60L31.2,53.6C32.75,53.86 34.35,54 36,54C49.255,54 60,44.6 60,33C60,21.4 49.255,12 36,12Z M24,26.75L48,26.75A1.25,1.25 0 0 1 48,29.25L24,29.25A1.25,1.25 0 0 1 24,26.75Z M24,32.75L44,32.75A1.25,1.25 0 0 1 44,35.25L24,35.25A1.25,1.25 0 0 1 24,32.75Z M24,38.75L38,38.75A1.25,1.25 0 0 1 38,41.25L24,41.25A1.25,1.25 0 0 1 24,38.75Z" />

    </group>

</vector>
