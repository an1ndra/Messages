<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Messages" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- The keyguard takeover. Translucent and background-less so it never
         paints over the lock screen wallpaper while handing off, and it turns
         the panel on rather than waiting for a touch. -->
    <style name="Theme.Messages.FullScreen" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
