<?xml version="1.0" encoding="utf-8"?>
<!-- The composer's record button: a level meter rather than a microphone.
     Six round-capped bars, short at the edges and tallest in the middle, so the
     control reads as "a voice message" at 24dp without needing to be a literal
     microphone. Tinted by the caller; the strokes are what carry the shape. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:pathData="M2.4,11.2 L2.4,12.8"
        android:strokeColor="#FF000000"
        android:strokeWidth="2.6"
        android:strokeLineCap="round" />
    <path
        android:pathData="M6.3,8.4 L6.3,15.6"
        android:strokeColor="#FF000000"
        android:strokeWidth="2.6"
        android:strokeLineCap="round" />
    <path
        android:pathData="M10.2,3 L10.2,21"
        android:strokeColor="#FF000000"
        android:strokeWidth="2.6"
        android:strokeLineCap="round" />
    <path
        android:pathData="M14.1,7 L14.1,17"
        android:strokeColor="#FF000000"
        android:strokeWidth="2.6"
        android:strokeLineCap="round" />
    <path
        android:pathData="M18,9.6 L18,14.4"
        android:strokeColor="#FF000000"
        android:strokeWidth="2.6"
        android:strokeLineCap="round" />
    <path
        android:pathData="M21.6,11.2 L21.6,12.8"
        android:strokeColor="#FF000000"
        android:strokeWidth="2.6"
        android:strokeLineCap="round" />
</vector>
